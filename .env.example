# NewsAPI — get key at https://newsapi.org/register
NEWSAPI_KEY=

# Reddit bulk dataset (path to downloaded Kaggle dump / torrent)
# Live PRAW ingestion is disabled on this project (Reddit auth blocked
# on the registered account). Reddit data comes from this dump only.
REDDIT_BULK_PATH=/data/dumps/reddit_comments.csv.zst

# HDFS
HDFS_NAMENODE=namenode
HDFS_PORT=9000
HDFS_WEB_UI_PORT=9870

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gold
POSTGRES_USER=gold
POSTGRES_PASSWORD=gold

# Spark
SPARK_MASTER_URL=spark://spark-master:7077

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus
PROMETHEUS_RETENTION=15d

# cAdvisor
CADVISOR_PORT=8081

# Pushgateway (used by Python jobs to push metrics)
PUSHGATEWAY_URL=pushgateway:9091
