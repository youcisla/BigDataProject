# CoinGecko API (free tier, no key needed, 10-30 calls/min)
# Used by scripts/fetch_crypto_live.py

# Stocks bulk archive (Kaggle borismarjanovic, 5GB+)
# Download: https://www.kaggle.com/datasets/borismarjanovic/price-volume-data-for-all-us-stocks-etfs
# Place CSV at this path, then set STOCKS_BULK_PATH=path/to/file.csv
STOCKS_BULK_PATH=data/stocks_etfs.csv

# Crypto news headlines (Kaggle aaroncbastian)
# Download: https://www.kaggle.com/datasets/aaroncbastian/crypto-news-headlines-and-market-prices-by-date
NEWS_BULK_PATH=data/crypto_news.csv

# HDFS
HDFS_NAMENODE=namenode
HDFS_PORT=9000
HDFS_WEB_UI_PORT=9870

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gold
POSTGRES_USER=gold
POSTGRES_PASSWORD=gold

# Spark
SPARK_MASTER_URL=spark://spark-master:7077

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus
PROMETHEUS_RETENTION=15d

# cAdvisor
CADVISOR_PORT=8081

# Pushgateway (used by Python jobs to push metrics)
PUSHGATEWAY_URL=pushgateway:9091
