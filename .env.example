# Stocks + ETF OHLCV archive (Kaggle borismarjanovic, ~5 GB extracted)
# Download: https://www.kaggle.com/datasets/borismarjanovic/price-volume-data-for-all-us-stocks-etfs
# Extract so that the *.us.txt files land in these directories.
STOCKS_DIR=data/Stocks
ETFS_DIR=data/ETFs

# Crypto OHLCV + news headlines (CryptoDataDownload per-coin CSVs, e.g. data/BTC.csv).
# The `articles` column carries the unstructured headline text.
CRYPTO_DIR=data

# Optional: restrict stock ingestion to one ticker per line in this file.
# TICKERS_FILE=data/test_tickers.txt

# Where Bronze records land when HDFS is unreachable (defaults to the system temp dir).
# BRONZE_LOCAL_FALLBACK=

# HDFS
HDFS_NAMENODE=namenode
HDFS_PORT=9000
HDFS_WEB_UI_PORT=9870

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=gold
POSTGRES_USER=gold
POSTGRES_PASSWORD=gold

# Spark
SPARK_MASTER_URL=spark://spark-master:7077

# Grafana
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus
PROMETHEUS_RETENTION=15d

# cAdvisor
CADVISOR_PORT=8081

# Pushgateway (used by Python jobs to push metrics)
PUSHGATEWAY_URL=pushgateway:9091
